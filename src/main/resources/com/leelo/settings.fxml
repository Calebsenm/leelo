<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" stylesheets="@css/main.css" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.leelo.controller.settingsController">

    <left>
        <fx:include source="side_menu.fxml" />
    </left>

    <center>
        <BorderPane>
            <center>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" vbarPolicy="AS_NEEDED">
                    <content>
                <VBox alignment="TOP_CENTER" styleClass="page">
                    <children>
                        <VBox maxWidth="900.0" spacing="18">
                            <children>
                                <HBox styleClass="page-header">
                                    <children>
                                        <VBox styleClass="page-heading">
                                            <children>
                                                <Label styleClass="page-title" text="Ajustes" />
                                                <Label styleClass="page-subtitle" text="Adapta Leelo a tu forma de leer y estudiar." />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox styleClass="card, form-card">
                                    <children>
                                        <Label styleClass="section-title" text="Preferencias generales" />
                                        <HBox spacing="16">
                                            <children>
                                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="form-label" text="Idioma actual" />
                                                        <ComboBox fx:id="languageCombo" maxWidth="Infinity" styleClass="form-input" />
                                                        <Label styleClass="field-hint"
                                                               text="Se usa por defecto al agregar textos y palabras." />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox styleClass="card, form-card">
                                    <children>
                                        <Label styleClass="section-title" text="Lectura" />
                                        <VBox spacing="9">
                                            <children>
                                                <CheckBox fx:id="showHighlightsCheck" text="Mostrar los colores de las palabras" />
                                                <CheckBox fx:id="showStreakCheck" text="Mostrar la racha de lectura en el inicio" />
                                                <CheckBox fx:id="promoteParentCheck" text="Promover la traducción del padre" />
                                                <CheckBox fx:id="showComponentsCheck" text="Mostrar los componentes del término" />
                                            </children>
                                        </VBox>
                                        <HBox spacing="16">
                                            <children>
                                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="form-label" text="Tamaño de fuente" />
                                                        <Spinner fx:id="fontSizeSpinner" maxWidth="Infinity" styleClass="form-input" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="form-label" text="Muestras de estadísticas" />
                                                        <Spinner fx:id="sampleSizeSpinner" maxWidth="Infinity" styleClass="form-input" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox styleClass="card, form-card">
                                    <children>
                                        <VBox spacing="2">
                                            <children>
                                                <Label styleClass="section-title" text="Atajos de teclado" />
                                                <Label styleClass="field-hint"
                                                       text="Haz doble clic en una fila para cambiar la combinación." />
                                            </children>
                                        </VBox>
                                        <TableView fx:id="hotkeysTable" prefHeight="300.0" styleClass="table-view">
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                            <columns>
                                                <TableColumn fx:id="categoryCol" prefWidth="140.0" text="CATEGORÍA" />
                                                <TableColumn fx:id="actionCol" prefWidth="380.0" text="ACCIÓN" />
                                                <TableColumn fx:id="shortcutCol" prefWidth="180.0" text="ATAJO" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>

                                <VBox fx:id="messageContainer" visible="false">
                                    <children>
                                        <Label fx:id="messageLabel" styleClass="text-sm, text-success" text="" wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
                    </content>
                </ScrollPane>
            </center>
            <bottom>
                <HBox styleClass="bottom-bar">
                    <children>
                        <Button fx:id="backButton" styleClass="btn, btn-ghost" text="←  Volver" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="saveButton" styleClass="btn, btn-primary" text="Guardar cambios" />
                    </children>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
