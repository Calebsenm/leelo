<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="sidebar" prefHeight="700.0" prefWidth="228.0" stylesheets="@css/main.css"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.leelo.controller.SideMenuController">
    <children>
        <HBox alignment="CENTER_LEFT" styleClass="brand">
            <children>
                <Label styleClass="brand-mark" text="L" />
                <VBox styleClass="brand-text">
                    <children>
                        <Label styleClass="brand-name" text="Leelo" />
                        <Label styleClass="brand-caption" text="Lectura y vocabulario" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <Label styleClass="nav-group-label" text="BIBLIOTECA" />
        <Button fx:id="homeButton" maxWidth="Infinity" styleClass="nav-btn" text="Inicio" />
        <Button fx:id="textButton" maxWidth="Infinity" styleClass="nav-btn" text="Textos" />

        <Label styleClass="nav-group-label" text="VOCABULARIO" />
        <Button fx:id="wordsButton" maxWidth="Infinity" styleClass="nav-btn" text="Palabras" />
        <Button fx:id="languagesButton" maxWidth="Infinity" styleClass="nav-btn" text="Idiomas" />
        <Button fx:id="tagsButton" maxWidth="Infinity" styleClass="nav-btn" text="Etiquetas" />

        <Label styleClass="nav-group-label" text="PROGRESO" />
        <Button fx:id="statsButton" maxWidth="Infinity" styleClass="nav-btn" text="Estadísticas" />

        <Region VBox.vgrow="ALWAYS" />

        <Separator styleClass="nav-separator" />
        <Button fx:id="settingsButton" maxWidth="Infinity" styleClass="nav-btn" text="Ajustes" />
        <Label styleClass="nav-version" text="Leelo 0.1.2" />
    </children>
</VBox>
