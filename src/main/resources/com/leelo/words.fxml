<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" styleClass="app-shell"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.leelo.controller.wordsController" stylesheets="@css/main.css">

    <left>
        <fx:include source="side_menu.fxml" />
    </left>

    <center>
        <VBox styleClass="page" VBox.vgrow="ALWAYS">
            <children>
                <HBox styleClass="page-header">
                    <children>
                        <VBox styleClass="page-heading">
                            <children>
                                <Label styleClass="page-title" text="Palabras" />
                                <Label styleClass="page-subtitle" text="Construye tu vocabulario y ajusta el estado de cada término." />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox styleClass="header-actions">
                            <children>
                                <Button fx:id="addButton" styleClass="btn, btn-primary" text="+ Nueva palabra" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox styleClass="filter-bar">
                    <children>
                        <TextField fx:id="searchWord" prefWidth="300.0" styleClass="search-input"
                                   promptText="Buscar por término o traducción..." HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="languageCombo" prefWidth="170.0" promptText="Todos los idiomas"
                                  styleClass="form-input" />
                        <CheckBox fx:id="parentsOnlyCheck" text="Sin padres" />
                        <CheckBox fx:id="includeIgnoredCheck" text="Incluir ignoradas" />
                    </children>
                </HBox>

                <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="wordsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="termCol" prefWidth="180.0" text="TÉRMINO" />
                                <TableColumn fx:id="translationCol" prefWidth="215.0" text="TRADUCCIÓN" />
                                <TableColumn fx:id="languageCol" prefWidth="105.0" text="IDIOMA" />
                                <TableColumn fx:id="statusCol" prefWidth="140.0" text="ESTADO" />
                                <TableColumn fx:id="tagsCol" prefWidth="130.0" text="ETIQUETAS" />
                                <TableColumn fx:id="parentsCol" prefWidth="110.0" text="PADRES" />
                            </columns>
                            <placeholder>
                                <Label text="No hay palabras todavía. Agrega la primera o importa un CSV."
                                       styleClass="text-sm" />
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>

                <HBox styleClass="action-bar">
                    <children>
                        <Label styleClass="form-label" text="Estado de la selección" />
                        <ComboBox fx:id="bulkStatusCombo" prefWidth="170.0" styleClass="form-input" />
                        <Button fx:id="bulkStatusButton" styleClass="btn, btn-sm" text="Aplicar" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="importButton" styleClass="btn, btn-sm, btn-ghost" text="Importar CSV" />
                        <Button fx:id="exportButton" styleClass="btn, btn-sm, btn-ghost" text="Exportar CSV" />
                    </children>
                </HBox>

                <HBox styleClass="page-footer">
                    <children>
                        <Button fx:id="backButton" styleClass="btn, btn-ghost" text="←  Volver" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="editButton" styleClass="btn" text="Editar" />
                        <Button fx:id="deleteButton" styleClass="btn, btn-danger" text="Eliminar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
