<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" styleClass="app-shell"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.leelo.controller.statisticsController" stylesheets="@css/main.css">

    <left>
        <fx:include source="side_menu.fxml" />
    </left>

    <center>
        <VBox styleClass="page" VBox.vgrow="ALWAYS">
            <children>
                <HBox styleClass="page-header">
                    <children>
                        <VBox styleClass="page-heading">
                            <children>
                                <Label styleClass="page-title" text="Estadísticas" />
                                <Label styleClass="page-subtitle" text="El pulso de tu actividad de lectura, día a día." />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_LEFT" styleClass="card, card-flat" spacing="10">
                            <children>
                                <Label styleClass="eyebrow" text="RACHA" />
                                <Label fx:id="streakLabel" styleClass="text-accent" text="" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <VBox styleClass="card" spacing="2">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <children>
                                <Label styleClass="section-title" text="Actividad de lectura" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="text-xs" text="Palabras leídas por día" />
                            </children>
                        </HBox>
                        <BarChart fx:id="chart" animated="false" alternativeColumnFillVisible="false"
                                  alternativeRowFillVisible="false" horizontalGridLinesVisible="true"
                                  legendVisible="false" prefHeight="220.0" styleClass="chart"
                                  verticalGridLinesVisible="false">
                            <xAxis>
                                <CategoryAxis fx:id="xAxis" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="yAxis" />
                            </yAxis>
                        </BarChart>
                    </children>
                </VBox>

                <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="statsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="languageCol" prefWidth="200.0" text="IDIOMA" />
                                <TableColumn fx:id="dayCol" prefWidth="90.0" text="HOY" />
                                <TableColumn fx:id="weekCol" prefWidth="90.0" text="SEMANA" />
                                <TableColumn fx:id="monthCol" prefWidth="90.0" text="MES" />
                                <TableColumn fx:id="yearCol" prefWidth="90.0" text="AÑO" />
                                <TableColumn fx:id="totalCol" prefWidth="110.0" text="TOTAL" />
                            </columns>
                            <placeholder>
                                <Label text="Todavía no hay lecturas registradas." styleClass="text-sm" />
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>

                <HBox styleClass="page-footer">
                    <children>
                        <Button fx:id="backButton" styleClass="btn, btn-ghost" text="←  Volver" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
