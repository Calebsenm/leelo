<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="430.0" prefWidth="520.0" styleClass="dialog-shell" stylesheets="@css/main.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.leelo.controller.addUrlController">
    <center>
        <VBox maxWidth="520.0" styleClass="dialog-body">
            <children>
                <VBox maxWidth="Infinity" styleClass="dialog-card">
                    <children>
                        <VBox spacing="3">
                            <children>
                                <Label styleClass="dialog-title" text="Importar desde URL" />
                                <Label styleClass="dialog-subtitle"
                                       text="Leelo extraerá automáticamente el contenido principal de la página." />
                            </children>
                        </VBox>

                        <VBox spacing="6">
                            <children>
                                <Label styleClass="form-label" text="Título (opcional)" />
                                <TextField fx:id="titleField" maxWidth="Infinity"
                                           promptText="Si lo dejas vacío, se usa el título de la página"
                                           styleClass="form-input" />
                            </children>
                        </VBox>

                        <VBox spacing="6">
                            <children>
                                <Label styleClass="form-label" text="URL *" />
                                <TextField fx:id="urlField" maxWidth="Infinity" promptText="https://ejemplo.com/articulo"
                                           styleClass="form-input" />
                            </children>
                        </VBox>

                        <Label fx:id="statusLabel" managed="false" styleClass="text-sm" text="" visible="false"
                               wrapText="true" />

                        <HBox alignment="CENTER_RIGHT" spacing="8">
                            <children>
                                <ProgressIndicator fx:id="loadingIndicator" maxHeight="20.0" maxWidth="20.0"
                                                   managed="false" visible="false" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="cancelButton" styleClass="btn, btn-ghost" text="Cancelar" />
                                <Button fx:id="saveButton" styleClass="btn, btn-primary" text="Importar contenido" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
