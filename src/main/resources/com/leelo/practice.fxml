<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.leelo.controller.PracticeController" styleClass="root" stylesheets="@css/main.css">
    <left>
        <fx:include fx:id="menu" source="side_menu.fxml" />
    </left>
    <center>
        <VBox alignment="TOP_CENTER" styleClass="practice-screen">

            <VBox alignment="CENTER" styleClass="card, practice-header-card">
                <Label text="Practica de Vocabulario" styleClass="title-lg, text-primary" />
                <HBox alignment="CENTER" styleClass="spacing-md">
                    <Label text="Modo:" styleClass="text-sm, text-secondary" />
                    <ComboBox fx:id="modeCombo" prefWidth="220.0" />
                </HBox>
                <Label fx:id="modeDescriptionLabel" text="Selecciona un modo y empieza la practica." styleClass="text-sm, text-secondary" wrapText="true" />
                <ProgressBar fx:id="progressBar" prefWidth="620.0" prefHeight="8.0" progress="0.0" styleClass="progress-primary" />
                <Label fx:id="progressLabel" text="Progress: Ready to start" styleClass="text-sm, text-secondary" />
            </VBox>

            <VBox alignment="CENTER" styleClass="card, practice-main-card">
                <Label fx:id="wordLabel" text="Ready to practice" styleClass="title-xxl, text-primary, text-bold" textAlignment="CENTER" wrapText="true" />
                <Label fx:id="translationLabel" text="" styleClass="title-lg, text-success, text-bold" visible="false" managed="false" textAlignment="CENTER" wrapText="true" />
                <Label fx:id="pronunciationLabel" text="" styleClass="text-lg, text-secondary, text-italic" visible="false" managed="false" textAlignment="CENTER" />
                <Label fx:id="feedbackLabel" text="" styleClass="text-sm" visible="false" managed="false" />

                <VBox fx:id="challengeBox" alignment="CENTER" styleClass="practice-answer-box" visible="false" managed="false">
                    <TextField fx:id="challengeInput" prefWidth="280" promptText="Escribe la palabra correcta" styleClass="form-input, practice-input" />
                    <Button fx:id="submitAnswerButton" text="Verificar" onAction="#submitChallengeAnswer" styleClass="btn" prefWidth="140.0" />
                </VBox>

                <TilePane fx:id="choiceBox" alignment="CENTER" prefColumns="2" hgap="10.0" vgap="10.0" styleClass="practice-choice-grid" visible="false" managed="false">
                    <Button fx:id="choiceButton1" onAction="#selectChoice1" styleClass="btn, practice-option-btn" prefWidth="250.0" />
                    <Button fx:id="choiceButton2" onAction="#selectChoice2" styleClass="btn, practice-option-btn" prefWidth="250.0" />
                    <Button fx:id="choiceButton3" onAction="#selectChoice3" styleClass="btn, practice-option-btn" prefWidth="250.0" />
                    <Button fx:id="choiceButton4" onAction="#selectChoice4" styleClass="btn, practice-option-btn" prefWidth="250.0" />
                </TilePane>
            </VBox>

            <VBox alignment="CENTER" styleClass="practice-actions">
                <VBox alignment="CENTER" styleClass="spacing-sm">
                    <Button fx:id="startSessionButton" text="Iniciar practica" onAction="#startStudySession" styleClass="btn" prefWidth="280.0" prefHeight="52.0" />
                </VBox>

                <HBox styleClass="spacing-md" alignment="CENTER">
                    <Button fx:id="nextButton" text="Saltar" onAction="#skipWord" styleClass="btn" prefWidth="110.0" visible="false" managed="false" />
                    <Button fx:id="continueButton" text="Continuar" onAction="#continueAfterFeedback" styleClass="btn" prefWidth="120.0" visible="false" managed="false" />
                    <Button fx:id="endSessionButton" text="Finalizar" onAction="#endStudySession" styleClass="btn" prefWidth="120.0" visible="false" managed="false" />
                </HBox>
            </VBox>

            <Label fx:id="sessionStatsLabel" text="" styleClass="text-xs, text-muted, practice-stats" />
        </VBox>
    </center>
</BorderPane>
