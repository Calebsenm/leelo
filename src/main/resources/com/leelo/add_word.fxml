<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-shell" stylesheets="@css/main.css"
            vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.leelo.controller.addWordController">
    <content>
        <VBox styleClass="dialog-body">
            <children>
                <VBox spacing="3">
                    <children>
                        <Label fx:id="titleLabel" styleClass="dialog-title" text="Nueva palabra" />
                        <Label styleClass="dialog-subtitle"
                               text="Gestiona la traducción, el estado y la información del término." />
                    </children>
                </VBox>

                <Separator />

                <HBox spacing="12">
                    <children>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" text="Idioma" />
                                <ComboBox fx:id="languageCombo" maxWidth="Infinity" styleClass="form-input" />
                            </children>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" text="Estado" />
                                <ComboBox fx:id="statusCombo" maxWidth="Infinity" styleClass="form-input" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="6">
                    <children>
                        <Label styleClass="form-label" text="Término *" />
                        <TextField fx:id="termField" maxWidth="Infinity" promptText="Palabra o expresión"
                                   styleClass="form-input" />
                    </children>
                </VBox>

                <VBox spacing="6">
                    <children>
                        <Label styleClass="form-label" text="Traducción" />
                        <TextArea fx:id="translationArea" prefRowCount="3" styleClass="form-textarea" wrapText="true" />
                    </children>
                </VBox>

                <VBox spacing="6">
                    <children>
                        <Label styleClass="form-label" text="Pronunciación" />
                        <TextField fx:id="pronunciationField" maxWidth="Infinity" promptText="Opcional"
                                   styleClass="form-input" />
                    </children>
                </VBox>

                <HBox spacing="12">
                    <children>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" text="Padres" />
                                <TextField fx:id="parentsField" maxWidth="Infinity" promptText="Separados por comas"
                                           styleClass="form-input" />
                            </children>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" text="Etiquetas" />
                                <TextField fx:id="tagsField" maxWidth="Infinity" promptText="Separadas por comas"
                                           styleClass="form-input" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="6">
                    <children>
                        <Label styleClass="form-label" text="Imagen" />
                        <TextField fx:id="urlImgField" maxWidth="Infinity" promptText="https://..."
                                   styleClass="form-input" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <ImageView fx:id="imagePreview" fitHeight="110.0" fitWidth="160.0" pickOnBounds="true"
                                   preserveRatio="true" visible="false" managed="false" />
                    </children>
                </HBox>

                <Label fx:id="messageLabel" styleClass="text-xs, text-error" text="" visible="false" wrapText="true" />

                <Separator />

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <children>
                        <Button fx:id="deleteButton" styleClass="btn, btn-danger" text="Eliminar" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="cancelButton" styleClass="btn, btn-ghost" text="Cancelar" />
                        <Button fx:id="saveButton" styleClass="btn, btn-primary" text="Guardar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
