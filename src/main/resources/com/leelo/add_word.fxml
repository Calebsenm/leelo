<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" stylesheets="@css/main.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.leelo.controller.addWordController">
    <content>
        <VBox fx:id="modalRoot" alignment="TOP_CENTER" spacing="12" prefWidth="390.0" minWidth="390.0" styleClass="form-compact" style="-fx-padding: 16; -fx-background-radius: 10; -fx-border-radius: 10;">
            <children>
                <Label fx:id="titleLabel" text="Editar palabra" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #1f2937;" />
                <Label text="Gestiona significados y estado de aprendizaje" styleClass="text-xs, text-secondary" />
                <Separator prefWidth="340" />

                <Label text="Palabra" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <TextField fx:id="termField" maxWidth="340.0" promptText="Termino" />

                <Label text="Significados" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <VBox fx:id="meaningsContainer" spacing="8" maxWidth="340.0" prefWidth="340.0" />
                <Button fx:id="addMeaningButton" styleClass="btn" maxWidth="340.0" text="+ Agregar significado" />

                <Label text="Pronunciacion (opcional)" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <TextField fx:id="pronunciationField" maxWidth="340.0" promptText="Pronunciacion" />

                <Label text="URL imagen (opcional)" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <HBox alignment="CENTER" spacing="8" maxWidth="340.0" prefWidth="340.0">
                    <children>
                        <TextField fx:id="urlImgField" promptText="https://..." HBox.hgrow="ALWAYS" />
                        <Button fx:id="searchImageButton" minWidth="36.0" prefWidth="36.0" text="" />
                    </children>
                </HBox>
                <ImageView fx:id="imagePreview" fitHeight="110.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" visible="false" managed="false" />

                <Label text="Estado" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <ComboBox fx:id="stateCombo" maxWidth="340.0" />

                <Button fx:id="saveButton" styleClass="btn" maxWidth="340.0" minHeight="34.0" text="Guardar palabra" />
                <Label fx:id="messageLabel" styleClass="text-xs, text-error" text="" visible="false" />
            </children>
        </VBox>
    </content>
</ScrollPane>
