<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" styleClass="app-shell"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.leelo.controller.languagesController" stylesheets="@css/main.css">

    <left>
        <fx:include source="side_menu.fxml" />
    </left>

    <center>
        <VBox styleClass="page" VBox.vgrow="ALWAYS">
            <children>
                <HBox styleClass="page-header">
                    <children>
                        <VBox styleClass="page-heading">
                            <children>
                                <Label styleClass="page-title" text="Idiomas" />
                                <Label styleClass="page-subtitle" text="Cada idioma define cómo se dividen los textos en palabras y frases." />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox styleClass="header-actions">
                            <children>
                                <Button fx:id="addButton" styleClass="btn, btn-primary" text="+ Nuevo idioma" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="languagesTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="nameCol" prefWidth="260.0" text="NOMBRE" />
                                <TableColumn fx:id="parserCol" prefWidth="220.0" text="ANALIZADOR" />
                                <TableColumn fx:id="booksCol" prefWidth="120.0" text="TEXTOS" />
                            </columns>
                            <placeholder>
                                <Label text="No hay idiomas todavía. Crea el primero con «Nuevo idioma»."
                                       styleClass="text-sm" />
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>

                <HBox styleClass="page-footer">
                    <children>
                        <Button fx:id="backButton" styleClass="btn, btn-ghost" text="←  Volver" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="editButton" styleClass="btn" text="Editar" />
                        <Button fx:id="deleteButton" styleClass="btn, btn-danger" text="Eliminar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
