<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" stylesheets="@css/main.css" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.leelo.controller.addTextController">

    <left>
        <fx:include source="side_menu.fxml" />
    </left>

    <center>
        <BorderPane>
            <center>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" vbarPolicy="AS_NEEDED">
                    <content>
                        <VBox alignment="TOP_CENTER" styleClass="page">
                            <children>
                <VBox maxWidth="1000.0" spacing="18">
                    <children>
                        <HBox styleClass="page-header">
                            <children>
                                <VBox styleClass="page-heading">
                                    <children>
                                        <Label fx:id="formTitleLabel" styleClass="page-title" text="Agregar texto" />
                                        <Label styleClass="page-subtitle"
                                               text="Pega el contenido, importa un archivo o trae una página web." />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox styleClass="card, form-card">
                            <children>
                                <Label styleClass="section-title" text="Información del texto" />
                                <HBox spacing="16">
                                    <children>
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-label" text="Título *" />
                                                <TextField fx:id="titleField" maxWidth="Infinity" promptText="Título del texto"
                                                           styleClass="form-input" />
                                                <Label fx:id="titleValidationLabel" styleClass="text-sm, text-error"
                                                       text="" visible="false" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-label" text="Idioma *" />
                                                <ComboBox fx:id="languageCombo" maxWidth="Infinity" styleClass="form-input" />
                                                <Label fx:id="languageValidationLabel" styleClass="text-sm, text-error"
                                                       text="" visible="false" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox spacing="16">
                                    <children>
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-label" text="Dividir por" />
                                                <ComboBox fx:id="splitByCombo" maxWidth="Infinity" styleClass="form-input" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-label" text="Palabras por página" />
                                                <Spinner fx:id="thresholdSpinner" maxWidth="Infinity" styleClass="form-input" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-label" text="Etiquetas" />
                                                <TextField fx:id="tagsField" maxWidth="Infinity" promptText="Separadas por comas"
                                                           styleClass="form-input" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="6">
                                    <children>
                                        <Label styleClass="form-label" text="Fuente (opcional)" />
                                        <TextField fx:id="sourceUriField" maxWidth="Infinity"
                                                   promptText="https://sitio.com/articulo" styleClass="form-input" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox styleClass="card, form-card" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Contenido *" />
                                <TextArea fx:id="areaContent" prefRowCount="8" promptText="Pega aquí el contenido del texto..."
                                          styleClass="form-textarea" VBox.vgrow="ALWAYS" wrapText="true" />
                                <Label fx:id="contentValidationLabel" styleClass="text-sm, text-error" text="" visible="false" />
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <children>
                                        <Label fx:id="characterCountLabel" styleClass="text-xs" text="0 caracteres" />
                                        <Label styleClass="text-xs" text="·" />
                                        <Label fx:id="wordCountLabel" styleClass="text-xs" text="0 palabras" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox fx:id="messageContainer" visible="false">
                            <children>
                                <Label fx:id="messageLabel" styleClass="text-sm, text-success" text="" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
            <bottom>
                <HBox fx:id="buttonContainer" styleClass="bottom-bar">
                    <children>
                        <Button fx:id="backButton" styleClass="btn, btn-ghost" text="←  Cancelar" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="form-label" text="Importar" />
                        <Button fx:id="pdfButton" styleClass="btn, btn-secondary, btn-sm" text="PDF" />
                        <Button fx:id="txtButton" styleClass="btn, btn-secondary, btn-sm" text="TXT" />
                        <Button fx:id="urlButton" styleClass="btn, btn-secondary, btn-sm" text="URL" />
                        <Button fx:id="saveButton" styleClass="btn, btn-primary" text="Guardar texto" />
                    </children>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
