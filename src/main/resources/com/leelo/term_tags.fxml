<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" styleClass="app-shell"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.leelo.controller.termTagsController" stylesheets="@css/main.css">

    <left>
        <fx:include source="side_menu.fxml" />
    </left>

    <center>
        <VBox styleClass="page" VBox.vgrow="ALWAYS">
            <children>
                <HBox styleClass="page-header">
                    <children>
                        <VBox styleClass="page-heading">
                            <children>
                                <Label styleClass="page-title" text="Etiquetas" />
                                <Label styleClass="page-subtitle" text="Agrupa tus palabras por tema, origen o cualquier criterio propio." />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox styleClass="filter-bar">
                    <children>
                        <TextField fx:id="newTagField" styleClass="search-input" promptText="Nombre de la nueva etiqueta"
                                   HBox.hgrow="ALWAYS" />
                        <Button fx:id="addButton" styleClass="btn, btn-primary" text="+ Agregar" />
                    </children>
                </HBox>

                <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tagsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="textCol" prefWidth="240.0" text="ETIQUETA" />
                                <TableColumn fx:id="commentCol" prefWidth="380.0" text="COMENTARIO" />
                                <TableColumn fx:id="countCol" prefWidth="120.0" text="PALABRAS" />
                            </columns>
                            <placeholder>
                                <Label text="No hay etiquetas. Crea una con el campo de arriba." styleClass="text-sm" />
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>

                <HBox styleClass="page-footer">
                    <children>
                        <Button fx:id="backButton" styleClass="btn, btn-ghost" text="←  Volver" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="editButton" styleClass="btn" text="Editar" />
                        <Button fx:id="deleteButton" styleClass="btn, btn-danger" text="Eliminar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
